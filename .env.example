# Copy to .env and change every value before any real use.
OPENSALON_SECRET_KEY=dev-only-change-me
POSTGRES_DB=opensalon
POSTGRES_USER=opensalon
POSTGRES_PASSWORD=opensalon-dev-only
# POSTGRES_HOST is set by docker-compose; leave unset for local runs
# (local runs without it fall back to a SQLite file for a first look).
